# Kotatsu server configuration
# Copy to .env and fill in your values

# Canonical HTTPS origin for the server (required)
KOTATSU_PUBLIC_URL=https://shell.example.com

# Comma-separated trusted forwarding proxy CIDRs (e.g., "172.20.0.1/32")
KOTATSU_TRUSTED_PROXIES=

# Pinned agent release tag (required for installer)
KOTATSU_RELEASE_VERSION=v0.1.0

# HTTPS origin serving pinned release artifacts (required for installer)
# For GitHub-hosted releases, use: https://github.com/OWNER/REPO/releases/download
KOTATSU_RELEASE_URL=https://github.com/koboshchan/kotatsu/releases/download

# Optional local directory for allowlisted release files (alternative to RELEASE_URL)
# KOTATSU_RELEASE_DIR=/path/to/releases

# Compose loopback host port (default: 28473)
KOTATSU_PORT=28473

# Set to 1 for explicit development-only HTTP (disables HTTPS requirement)
KOTATSU_DEV=0